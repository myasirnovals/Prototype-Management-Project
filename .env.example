# ==========================================
# CLIENT / FRONTEND ENVIRONMENT VARIABLES (Vite)
# ==========================================

# URL Proyek Supabase Anda (Dapatkan dari: Supabase Dashboard > Project Settings > API > Project URL)
# Contoh: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Dapatkan dari: Supabase Dashboard > Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==========================================
# BACKEND / SERVERLESS ENVIRONMENT VARIABLES
# ==========================================

# Port lokal untuk Express backend server (opsional saat dev lokal)
PORT=5000

# PostgreSQL Connection String dari Supabase (Connection Pooling - Transaction mode, port 6543)
# Dapatkan dari: Supabase Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Aktifkan SSL untuk koneksi PostgreSQL
DB_SSL=true

# ==========================================
# SMTP / EMAIL NOTIFICATIONS (OPSIONAL)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Project Management Portal" <no-reply@domain.com>

# Port Server Backend Lokal
PORT=5000

# Konfigurasi Database PostgreSQL (Supabase Cloud)
# Format URI: postgresql://postgres.[project-ref]:[your-password]@[host]:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# URL & Public Key Supabase (opsional jika backend perlu SDK)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
